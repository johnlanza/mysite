# Copy this file to .env.smoke and fill in local-only verification values.
# .env.smoke is ignored by git and is loaded automatically by smoke/status scripts.

PODCAST_CLUB_BASE_URL=https://mysite-staging.onrender.com/podcastclub
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-

# Optional: verify one specific deploy instead of the service's latest deploy.
# RENDER_DEPLOY_ID=dep-

# Use either email/password or a full session cookie header.
PODCAST_CLUB_EMAIL=smoke@example.com
PODCAST_CLUB_PASSWORD=
# PODCAST_CLUB_SESSION_COOKIE=mysite_session=...

# Set this only if the staging cookie name differs from the app default.
# PODCAST_CLUB_SESSION_COOKIE_NAME=mysite_session

# Set this only for an intentional production write smoke.
# PODCAST_CLUB_ALLOW_PRODUCTION_SMOKE=1
